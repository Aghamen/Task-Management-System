# Copy to .env and fill in before running `docker compose up -d --build`

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-long-random-string

# Super admin account, created on first start only
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@yourcompany.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Local port the app listens on (nginx/Caddy proxies the subdomain to it)
APP_PORT=3000

# Keep true when served over HTTPS. Set to false only for testing over plain http.
COOKIE_SECURE=true
