# Used by `npm run dev`. `npm run setup` copies this to .env for you.
# Default: the Postgres started by `npm run db` (Docker, port 5433).
# Using your own Postgres instead? Change the URL below.
DATABASE_URL=postgresql://taskboard:taskboard@localhost:5433/taskboard

# Created on first start if no super admin exists yet
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@localhost.local
SUPERADMIN_PASSWORD=admin12345

PORT=3000
# Keep false for http://localhost; set true when served over HTTPS
COOKIE_SECURE=false
